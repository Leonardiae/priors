{
  "name": "@priors/mcp",
  "mcpName": "io.github.priors-agents/priors",
  "version": "0.10.0",
  "private": false,
  "description": "MCP server for Priors on Robinhood Chain: pay x402 URLs in USDG, read balances, credit lines and scores, borrow and repay, and buy, sell and redeem PT-USDG. Key from PRIORS_KEY_FILE (a file only you can read) or PRIORS_KEY, never the command line.",
  "type": "module",
  "bin": {
    "priors-mcp": "bin/priors-mcp.mjs"
  },
  "main": "./src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./share": "./src/share.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "deployments",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "x402",
    "robinhood-chain",
    "usdg",
    "agents",
    "credit",
    "priors"
  ],
  "license": "MIT",
  "homepage": "https://mcp.priors.trade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priors-agents/priors.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/priors-agents/priors/issues"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@priors/x402": "0.8.0",
    "ethers": "^6.13.4",
    "undici": "6.29.0",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  }
}
