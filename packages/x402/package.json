{
  "name": "@priors/x402",
  "version": "0.8.0",
  "private": false,
  "description": "x402 v2 on Robinhood Chain (eip155:4663) in USDG: a money parser for ExactEvmScheme, the Priors facilitator config, and a payer that borrows the gap from a Priors credit line.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./credit": {
      "types": "./credit.d.ts",
      "import": "./src/credit.mjs"
    },
    "./savings": {
      "types": "./savings.d.ts",
      "import": "./src/savings.mjs"
    },
    "./autopay": {
      "types": "./autopay.d.ts",
      "import": "./src/autopay.mjs"
    },
    "./bridge": {
      "types": "./bridge.d.ts",
      "import": "./src/bridge.mjs"
    },
    "./check": {
      "types": "./check.d.ts",
      "import": "./src/check.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "credit.d.ts",
    "savings.d.ts",
    "autopay.d.ts",
    "bridge.d.ts",
    "check.d.ts",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "x402",
    "robinhood-chain",
    "usdg",
    "agents",
    "credit",
    "priors"
  ],
  "license": "MIT",
  "homepage": "https://x402.priors.trade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priors-agents/priors.git",
    "directory": "packages/x402"
  },
  "bugs": {
    "url": "https://github.com/priors-agents/priors/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/fetch": "^2.27.0",
    "ethers": "^6.13.4"
  },
  "peerDependencies": {
    "@x402/express": "^2.27.0",
    "@x402/mcp": "^2.27.0"
  },
  "peerDependenciesMeta": {
    "@x402/express": {
      "optional": true
    },
    "@x402/mcp": {
      "optional": true
    }
  }
}
